{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Batide",
  "version": "0.1.0",
  "identifier": "dev.batide.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Batide",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "backgroundColor": "#0e0f13"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "DeveloperTool",
    "shortDescription": "IDE leve e rápida",
    "longDescription": "Batide: IDE leve e rápida, no navegador e no desktop, com git, GitHub e PL/SQL."
  }
}
